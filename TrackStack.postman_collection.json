    {
      "name": "Setlists",
      "item": [
        {
          "name": "Create setlist",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Weekend Techno Set\",\n  \"description\": \"Peak time warehouse vibes\",\n  \"slots\": [\n    {\n      \"trackId\": {{trackId}},\n      \"slotOrder\": 1,\n      \"energy\": 2,\n      \"notes\": \"Opener - keep it low\"\n    },\n    {\n      \"trackId\": {{trackId2}},\n      \"slotOrder\": 2,\n      \"energy\": 4,\n      \"notes\": \"Build energy\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/setlists",
              "host": ["{{baseUrl}}"],
              "path": ["api", "setlists"]
            }
          },
          "response": []
        },
        {
          "name": "Get all setlists",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
