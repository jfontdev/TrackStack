{
  "info": {
    "_postman_id": "b34ec584-2177-4aef-b4a0-74cb411c571e",
    "name": "TrackStack",
    "description": "TrackStack DJ Set Planning API — verified against actual codebase.\n\n**Implemented:** Tracks, Transitions, Setlists (CRUD + slots + energy-arc + validation + export), Health, AI transition suggestion.\n**Removed:** Tags (dropped in Phase 00).\n\n**Phase 03.5 endpoints:**\n- GET /api/setlists/{id}/energy-arc — energy progression visualization\n- GET /api/setlists/{id}/validate-transitions — track-to-track transition validation\n- POST /api/setlists/{id}/export?format=json|text — setlist export",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "13261274"
  },
  "item": [
    {
      "name": "Tracks",
      "item": [
        {
          "name": "Scan tracks",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tracks/scan",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tracks", "scan"]
            }
          },
          "response": []
        },
        {
          "name": "Get all tracks (paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tracks?page=0&size=20&sort=title,asc&bpmMin=130&bpmMax=140&key=4A&genre=Techno",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tracks"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "title,asc" },
                { "key": "bpmMin", "value": "130" },
                { "key": "bpmMax", "value": "140" },
                { "key": "key", "value": "4A" },
                { "key": "genre", "value": "Techno" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get track by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tracks/{{trackId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tracks", "{{trackId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Create track",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My Second Song\",\n  \"artist\": \"Jordi F\",\n  \"album\": \"Test Album\",\n  \"bpm\": 150,\n  \"key\": \"4A\",\n  \"durationSeconds\": 292,\n  \"genre\": \"Techno\",\n  \"filePath\": \"/music/test/track.mp3\",\n  \"fileFormat\": \"mp3\",\n  \"bitrate\": 320,\n  \"energy\": 4\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tracks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tracks"]
            }
          },
          "response": []
        },
        {
          "name": "PUT Update Track",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\",\n  \"artist\": \"Artist B\",\n  \"album\": \"Updated Album\",\n  \"bpm\": 140.0,\n  \"key\": \"D minor\",\n  \"durationSeconds\": 270,\n  \"genre\": \"Techno\",\n  \"filePath\": \"/music/test/track.mp3\",\n  \"fileFormat\": \"mp3\",\n  \"bitrate\": 320,\n  \"energy\": 3\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tracks/{{trackId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tracks", "{{trackId}}"]
            },
            "description": "Fully replaces a track (PUT semantics). All fields must be provided."
          },
          "response": []
        },
        {
          "name": "PATCH Update Track",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Patched Title\",\n  \"energy\": 5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tracks/{{trackId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tracks", "{{trackId}}"]
            },
            "description": "Partially updates a track (PATCH semantics). Only send fields to change."
          },
          "response": []
        },
        {
          "name": "Delete track",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tracks/{{trackId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tracks", "{{trackId}}"]
            }
          },
          "response": []
        }
      ]
